// medmlx.org on Cloudflare: the verified `make pages` export, served as static
// assets with no Worker script. `make deploy` uploads it.
{
  "name": "medmlx",
  "compatibility_date": "2026-10-12",
  "assets": {
    "directory": "./dist/pages",
    "not_found_handling": "404-page",
    "html_handling": "auto-trailing-slash"
  },
  // Serve only on medmlx.org: no workers.dev address and no preview URLs.
  "workers_dev": false,
  "preview_urls": false,
  "routes": [
    { "pattern": "medmlx.org", "custom_domain": true },
    { "pattern": "www.medmlx.org", "custom_domain": true }
  ]
}
